    "test:dom:shard2": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../core/src/**/*.ts",
        "../server/src/**/*.ts",
        "../md-conformance/src/**/*.ts",
        "../md-conformance/src/**/*.json",
        "../md-conformance/corpora/typed-view-scripts.json"
      ],
      "outputs": [
        "test-results/vitest-test-dom-shard2.json",
