{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "agentGuidance": false,
  "futureFlags": {
    "experimentalTaskCommand": true
  },
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [
    "turbo-cache-key.json",
    "test-support/fixtures/share-url-v1-v2.json",
    "test-support/fixtures/codex-legacy-warning-envelopes.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "patches/*.patch"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@gitquire/core#build:output": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "command": ["node", "scripts/build-output.mjs", "produce"]
    },
    "@gitquire/core#build": {
      "dependsOn": ["build:output"],
      "cache": false,
      "command": ["node", "scripts/build-output.mjs", "complete"]
    },
    "lint": {},
    "types": {
      "dependsOn": ["^types"]
    },
    "@gitquire/cli#types": {
      "dependsOn": ["^types", "build"]
    },
    "typecheck": {
      "env": ["TSRS_BINARY"],
      "dependsOn": ["^types", "//#typecheck:no-net-connect", "//#typecheck:lint-plugins"]
    },
    "//#typecheck:lint-plugins": {
      "env": ["TSRS_BINARY"],
      "inputs": [
        "lint-plugins/gq-rules/**/*.ts",
        "lint-plugins/gq-rules/tsconfig.json",
        "test-support/*.ts",
        "tsconfig.json"
      ]
    },
    "//#typecheck:no-net-connect": {
      "env": ["TSRS_BINARY"],
      "inputs": [
        "test-support/*.ts",
        "test-support/*.mts",
        "test-support/fixtures/no-net-connect/**/*.ts",
        "test-support/tsconfig.no-net-connect.json",
        "tsconfig.json"
      ]
    },
    "//#test:uncached": {
      "dependsOn": ["@gitquire/core#build"],
      "cache": false,
      "inputs": []
    },
    "@gitquire/cli#check:dts": {
      "dependsOn": ["build"],
      "inputs": [
        "tsconfig.check.json",
        "scripts/check-published-dts.mjs",
        "$TURBO_ROOT$/scripts/read-jsonc.mjs"
      ]
    },
    "@gitquire/core#check:dts": {
      "env": ["TSRS_BINARY"],
      "dependsOn": ["build"],
      "inputs": ["tsconfig.json", "tsconfig.check.json", "tests/contract/subpath-types/consumer.ts"]
    },
    "@gitquire/docs#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.test-helper.ts",
        "!vitest.config.ts",
        "!vitest.*.config.mts"
      ],
      "env": [
        "VERCEL_GIT_COMMIT_SHA",
        "GITHUB_SHA",
        "VERCEL_ENV",
        "GITQUIRE_ALLOW_BLOGLESS_LLMS_TXT",
        "GITQUIRE_ALLOW_PARTIAL_CHANGELOG",
        "CI",
        "VERCEL",
        "VERCEL_DEPLOYMENT_ID"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"],
      "outputs": ["test-results/vitest-test.json", "test-results/vitest-test.provenance.json"]
    },
    "@gitquire/docs#test": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"],
      "outputs": [
        "test-results/vitest-test.json",
        "test-results/vitest-test.provenance.json",
        "test-results/vitest-test-real-source.json",
        "test-results/vitest-test-real-source.provenance.json"
      ]
    },
    "@gitquire/server#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "../../test-support/*.ts",
        "../../test-support/test-only-source-file.mjs",
        "../app/src/editor/observers.ts"
      ],
      "outputs": ["test-results/vitest-test.json", "test-results/vitest-test.provenance.json"]
    },
    "@gitquire/server#test:shard1": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "../../test-support/*.ts",
        "../../test-support/test-only-source-file.mjs",
        "../app/src/editor/observers.ts"
      ],
      "outputs": [
        "test-results/vitest-test-shard1.json",
        "test-results/vitest-test-shard1.provenance.json"
      ]
    },
    "@gitquire/server#test:shard2": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "../../test-support/*.ts",
        "../../test-support/test-only-source-file.mjs",
        "../app/src/editor/observers.ts"
      ],
      "outputs": [
        "test-results/vitest-test-shard2.json",
        "test-results/vitest-test-shard2.provenance.json"
      ]
    },
    "@gitquire/server#test:shard3": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "../../test-support/*.ts",
        "../../test-support/test-only-source-file.mjs",
        "../app/src/editor/observers.ts"
      ],
      "outputs": [
        "test-results/vitest-test-shard3.json",
        "test-results/vitest-test-shard3.provenance.json"
      ]
    },
    "@gitquire/server#test:shard4": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "../../test-support/*.ts",
        "../../test-support/test-only-source-file.mjs",
        "../app/src/editor/observers.ts"
      ],
      "outputs": [
        "test-results/vitest-test-shard4.json",
        "test-results/vitest-test-shard4.provenance.json"
      ]
    },
    "@gitquire/cli#test": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "$TURBO_ROOT$/scripts/read-jsonc.mjs"
      ],
      "outputs": ["test-results/vitest-test.json", "test-results/vitest-test.provenance.json"]
    },
    "@gitquire/md-conformance#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**", "../server/src/**/*.ts"],
      "outputs": ["test-results/vitest-test.json", "test-results/vitest-test.provenance.json"]
    },
    "@gitquire/core#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"],
      "outputs": ["test-results/vitest-test.json", "test-results/vitest-test.provenance.json"]
    },
    "test:dom": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../core/src/**/*.ts",
        "../server/src/**/*.ts",
        "../md-conformance/src/**/*.ts",
        "../md-conformance/src/**/*.json",
        "../md-conformance/corpora/typed-view-scripts.json"
      ],
      "outputs": [
        "test-results/vitest-test-dom.json",
        "test-results/vitest-test-dom.provenance.json"
      ]
    },
    "test:dom:shard1": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
