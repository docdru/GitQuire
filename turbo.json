    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB",
        "VITEST_CHROMIUM_GC_FORCE",
        "DEBUG"
      ]
    },
    "test:node": {
      "dependsOn": ["^build"],
